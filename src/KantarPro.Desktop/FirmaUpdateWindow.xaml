<Window x:Class="KantarPro.Desktop.FirmaUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firma Guncelle"
        Width="430"
        Height="240"
        MinWidth="430"
        MinHeight="240"
        MaxWidth="560"
        MaxHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Firma Guncelle" FontSize="19" FontWeight="SemiBold" Foreground="#1B2430" />
        <TextBlock Grid.Row="1" Text="Secili arac kaydinin firma bilgisini gunceller." Foreground="#637083" Margin="0,4,0,14" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Plaka" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox x:Name="PlateTextBox" Grid.Column="1" IsReadOnly="True" Height="32" Padding="8,3" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Text="Firma" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="CompanyTextBox" Grid.Row="1" Grid.Column="1" CharacterCasing="Upper" Height="32" Padding="8,3" FontSize="15" FontWeight="SemiBold" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Kaydet" Width="96" MinHeight="34" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Vazgec" Width="96" MinHeight="34" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
