                                <StackPanel>
                                    <TextBlock Text="İçerideki Araçlar" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="Çıkış yapılacak aracı listeden seç." Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="Yenile" Width="110" Click="RefreshButton_Click" />
                            </DockPanel>

                            <DataGrid x:Name="ExitPageEntryVehiclesGrid" Grid.Row="1" ItemsSource="{Binding EntryVehiclesView}" SelectionChanged="ExitPageEntryVehiclesGrid_SelectionChanged" PreviewTextInput="EntryVehiclesGrid_PreviewTextInput" PreviewKeyDown="EntryVehiclesGrid_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Plaka}" Width="98">
                                        <DataGridTextColumn.Header>
                                            <StackPanel>
                                                <TextBlock Text="Plaka" />
                                                <TextBox Tag="EntryPlaka" Width="78" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Plaka filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding FirmaAdi}" Width="146">
                                        <DataGridTextColumn.Header>
                                            <StackPanel>
                                                <TextBlock Text="Firma" />
                                                <TextBox Tag="EntryFirma" Width="118" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Firma filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Giriş Tarihi" Binding="{Binding GirisTarihi}" Width="95" />
                                    <DataGridTextColumn Header="Giriş Saati" Binding="{Binding Saat}" Width="90" />
                                    <DataGridTextColumn Header="1. Tartım" Binding="{Binding Tartim}" Width="105" />
                                    <DataGridTextColumn Header="2. Tartım" Binding="{Binding IkinciTartim}" Width="105" />
                                    <DataGridTextColumn Header="Net" Binding="{Binding NetAgirlik}" Width="85" />
                                    <DataGridTextColumn Header="Ücret" Binding="{Binding Ucret}" Width="95" />
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="115" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Bugün Çıkış Yapan Araçlar" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ExitVehiclesView}" PreviewTextInput="ExitVehiclesGrid_PreviewTextInput" PreviewKeyDown="ExitVehiclesGrid_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Plaka}" Width="98">
                                        <DataGridTextColumn.Header>
                                            <StackPanel>
                                                <TextBlock Text="Plaka" />
                                                <TextBox Tag="ExitPlaka" Width="78" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Plaka filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding FirmaAdi}" Width="146">
                                        <DataGridTextColumn.Header>
                                            <StackPanel>
                                                <TextBlock Text="Firma" />
                                                <TextBox Tag="ExitFirma" Width="118" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Firma filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Giriş Tarihi" Binding="{Binding GirisTarihi}" Width="95" />
                                    <DataGridTextColumn Header="Çıkış Saati" Binding="{Binding Saat}" Width="90" />
                                    <DataGridTextColumn Header="1. Tartım" Binding="{Binding Tartim}" Width="105" />
                                    <DataGridTextColumn Header="2. Tartım" Binding="{Binding IkinciTartim}" Width="105" />
                                    <DataGridTextColumn Header="Net" Binding="{Binding NetAgirlik}" Width="85" />
                                    <DataGridTextColumn Header="Giriş-Çıkış" Binding="{Binding GirisCikisUcreti}" Width="95" />
                                    <DataGridTextColumn Header="Tartım Ücreti" Binding="{Binding TartimUcreti}" Width="95" />
                                    <DataGridTextColumn Header="Bekleme" Binding="{Binding BeklemeUcreti}" Width="85" />
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="105" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="DoluBosPageContent" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="22" Margin="0,0,18,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Dolu-Boş Tartım" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Ayni plakanin eski ilk tartimini kullan veya yeni ilk tartim ac." Foreground="{StaticResource Muted}" Margin="0,4,0,18" />

                            <TextBlock Text="Plaka" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="DoluBosPlakaTextBox" CharacterCasing="Upper" Text="06DMS294" Margin="0,0,0,12" />

                            <Button Content="Bekleyen Ilk Tartımlari Bul" Style="{StaticResource PrimaryButton}" Margin="0,0,0,16" Click="DoluBosBekleyenBul_Click" />

                            <Border Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Secim Karari" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                    <RadioButton x:Name="DoluBosEskiTartimRadio" Content="Eski ilk tartımı kullan" IsChecked="True" FontSize="15" Margin="0,10,0,6" />
                                    <RadioButton x:Name="DoluBosYeniIlkRadio" Content="Yeni ilk tartim olarak ac" FontSize="15" Margin="0,0,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Firma" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="DoluBosFirmaTextBox" Text="Yeni Firma / Nakliye" Margin="0,0,0,12" />

                            <TextBlock Text="Açıklama" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="DoluBosAciklamaTextBox" Height="70" FontSize="14" FontWeight="Normal" TextWrapping="Wrap" AcceptsReturn="True" Text="Sonradan boş tartım" Margin="0,0,0,16" />

                            <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Ücret Kuralı" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="Bu gelişte Giriş-Çıkış ve Tartım ücreti tahakkuk eder." Foreground="{StaticResource Muted}" Margin="0,8,0,2" />
                                    <TextBlock Text="Ayni gun cikarsa bekleme ucreti eklenmez." Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.9*" />
                        <RowDefinition Height="1.1*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Bekleyen Ilk Tartımlar" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="Ayni plakada birden fazla eski tartim varsa operator dogru satiri secer." Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="DoluBosBekleyenGrid" Grid.Row="1" ItemsSource="{Binding PendingWeighings}" SelectionChanged="DoluBosBekleyenGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Plaka" Binding="{Binding Plaka}" Width="90" />
                                    <DataGridTextColumn Header="Firma" Binding="{Binding FirmaAdi}" Width="170" />
                                    <DataGridTextColumn Header="İlk Tarih" Binding="{Binding IlkTartimTarihi}" Width="95" />
                                    <DataGridTextColumn Header="Saat" Binding="{Binding IlkTartimSaati}" Width="75" />
                                    <DataGridTextColumn Header="1.KG" Binding="{Binding IlkAgirlik}" Width="90" />
                                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="220" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Secilen Eski Ilk Tartım" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Plaka" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="DoluBosSeciliPlakaTextBox" Grid.Column="1" Text="06DMS294" IsReadOnly="True" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Firma" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="DoluBosSeciliFirmaTextBox" Grid.Column="1" Text="UZAY Lojistik" IsReadOnly="True" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ilk Tartım" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="DoluBosIlkTartimTextBox" Grid.Column="1" Text="24.03.2026 10:42:58" IsReadOnly="True" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="1.KG" Foreground="{StaticResource Muted}" />
                                    <TextBox x:Name="DoluBosIlkKgTextBox" Grid.Column="1" Text="16500" IsReadOnly="True" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Bugunku Tartım" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="2.KG" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBox x:Name="DoluBosIkinciKgTextBox" Grid.Column="1" Text="8200" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Net" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBox x:Name="DoluBosNetKgTextBox" Grid.Column="1" Text="8300" IsReadOnly="True" Foreground="#B91C1C" />
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tahakkuk" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBox x:Name="DoluBosTahakkukTextBox" Grid.Column="1" Text="732,00 TL" IsReadOnly="True" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Kilo Al" Style="{StaticResource PrimaryButton}" Margin="0,0,8,10" Click="DoluBosKiloAl_Click" />
                                    <Button Grid.Column="1" Content="Net Hesapla" Margin="8,0,0,10" Click="DoluBosNetHesapla_Click" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="DoluBosPrototypeButton_Click" />
                                    <Button Grid.Column="1" Content="Fiş Yazdır" Margin="8,0,0,0" Click="DoluBosPrototypeButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>










