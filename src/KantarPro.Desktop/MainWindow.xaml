<Window x:Class="KantarPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Gumruk Kantar Otomasyon Sistemi"
        Width="1320"
        Height="820"
        MinWidth="1180"
        MinHeight="720"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1B2430" />
        <SolidColorBrush x:Key="Muted" Color="#637083" />
        <SolidColorBrush x:Key="Line" Color="#D8E0E8" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Primary" Color="#0F766E" />
        <SolidColorBrush x:Key="PrimaryDark" Color="#115E59" />
        <SolidColorBrush x:Key="Warn" Color="#B45309" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDark}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#991B1B" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Gumruk Kantar Otomasyon Sistemi" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="Bursa Tasfiye Isletme Mudurlugu - Giris ve cikis kantari ortak operasyon ekrani" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,9" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ClockText" Text="19:30:00" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <Border Grid.Row="1" Background="#16202C" CornerRadius="6" Padding="10" Margin="0" Visibility="Collapsed">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Arac Giris" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="AracGirisButton_Click" />
                        <Button Content="Arac Cikis" Margin="0,0,8,0" Click="AracCikisButton_Click" />
                        <Button Content="Raporlar" Margin="0,0,8,0" Click="MenuButton_Click" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SQL: Bagli" Foreground="#86EFAC" Margin="18,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="COM: Beklemede" Foreground="#FCD34D" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Admin Kullanici" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="DashboardContent" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.02*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="0.86*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="470" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#ECECEC" BorderBrush="#9CA3AF" BorderThickness="1" Padding="8" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="1.Arac" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,10" />

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Plaka No:" VerticalAlignment="Center" Margin="0,0,6,8" />
                            <TextBox x:Name="PlakaTextBox" Grid.Column="1" CharacterCasing="Upper" Height="26" Padding="6,2" FontSize="13" FontWeight="Bold" Background="#C9E6C8" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Text="Giris Tarihi:" VerticalAlignment="Center" Margin="0,0,6,8" />
                            <TextBox x:Name="GirisTarihiTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding Source={x:Static sys:DateTime.Today}, Path=., Mode=OneWay, StringFormat={}{0:dd.MM.yyyy}}" Height="26" Padding="6,2" FontSize="13" FontWeight="Bold" Background="#C9E6C8" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Saat:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,8" />
                            <Border Grid.Row="1" Grid.Column="3" Background="#0284C7" BorderBrush="#0369A1" BorderThickness="1" Height="26" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Text, ElementName=ClockText}" Foreground="White" FontFamily="Consolas" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Grid.Row="2" Text="Cikis Tarihi:" VerticalAlignment="Center" Margin="0,0,6,8" />
                            <TextBox x:Name="CikisTarihiTextBox" Grid.Row="2" Grid.Column="1" Text="{Binding Source={x:Static sys:DateTime.Today}, Path=., Mode=OneWay, StringFormat={}{0:dd.MM.yyyy}}" Height="26" Padding="6,2" FontSize="13" FontWeight="Bold" Background="#C9E6C8" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Text="Musteri Adi:" VerticalAlignment="Center" Margin="0,0,6,8" />
                            <TextBox x:Name="FirmaTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="26" Padding="6,2" FontSize="13" FontWeight="SemiBold" Background="#C9E6C8" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Text="Aciklama:" VerticalAlignment="Center" Margin="0,0,6,8" />
                            <TextBox x:Name="AciklamaTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Height="26" Padding="6,2" FontSize="13" FontWeight="SemiBold" Background="#C9E6C8" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,0,8" />

                            <Grid Grid.Row="7" Grid.ColumnSpan="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1.KG:" FontSize="26" Foreground="Black" VerticalAlignment="Center" />
                                <TextBox x:Name="AgirlikTextBox" Grid.Column="1" Text="0" Height="48" Padding="8,5" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Background="#FFFFE1" BorderBrush="#6B7280" BorderThickness="1" TextAlignment="Right" />
                                <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" MinHeight="34" Padding="10,4" FontSize="13" Margin="0,0,0,6" Click="TartVeKaydet_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Vazgec" Style="{StaticResource DangerButton}" Width="92" MinHeight="34" Padding="10,4" FontSize="13" Click="PlakaDuzelt_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#F3F4F6" BorderBrush="#9CA3AF" BorderThickness="1" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Dolu-Boş Kantar Hareketleri" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid x:Name="EntryVehiclesGrid" MinWidth="980" ItemsSource="{Binding EntryVehiclesView}" SelectionChanged="EntryVehiclesGrid_SelectionChanged" PreviewTextInput="EntryVehiclesGrid_PreviewTextInput" PreviewKeyDown="EntryVehiclesGrid_PreviewKeyDown" PreviewMouseRightButtonDown="EntryVehiclesGrid_PreviewMouseRightButtonDown" AlternatingRowBackground="#D1D5DB" RowBackground="#F8FAFC" FontSize="13" RowHeight="28" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Tart" Click="EntryGridTartMenuItem_Click" />
                                        <MenuItem Header="Geliş Tarihini Güncelle" Click="EntryGridGelisTarihiniGuncelleMenuItem_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="110" />
                                    <DataGridTextColumn Binding="{Binding Plaka}" Width="98">
                                        <DataGridTextColumn.Header>
                                            <StackPanel>
                                                <TextBlock Text="Plaka" />
                                                <TextBox Tag="EntryPlaka" Width="78" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Plaka filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding FirmaAdi}" Width="146">
                                        <DataGridTextColumn.Header>
                                            <StackPanel>
                                                <TextBlock Text="Firma" />
                                                <TextBox Tag="EntryFirma" Width="118" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Firma filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Son Tartim Tarihi" Binding="{Binding SonTartimTarihi}" Width="108" />
                                    <DataGridTextColumn Header="Son Tartim Saati" Binding="{Binding SonTartimSaati}" Width="104" />
                                    <DataGridTextColumn Header="Tartim" Binding="{Binding SonTartim}" Width="96" />
                                    <DataGridTextColumn Header="Giris-Cikis" Binding="{Binding GirisCikisUcreti}" Width="92" />
                                    <DataGridTextColumn Header="Tartim Ucreti" Binding="{Binding TartimUcreti}" Width="92" />
                                    <DataGridTextColumn Header="Bekleme" Binding="{Binding BeklemeUcreti}" Width="82" />
                                    <DataGridTextColumn Header="Toplam" Binding="{Binding Ucret}" Width="92" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Cikis Yap" Style="{StaticResource PrimaryButton}" MinHeight="34" Padding="14,4" FontSize="13" Margin="0,0,8,0" Click="CikisIsleminiTamamla_Click" />
                            <Button Content="Makbuz" MinHeight="34" Padding="14,4" FontSize="13" Margin="0,0,8,0" Click="KantarFisiYazdir_Click" />
                            <Button Content="Menu" MinHeight="34" Padding="14,4" FontSize="13" Click="MenuButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#F3F4F6" BorderBrush="#9CA3AF" BorderThickness="1" Padding="4" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Kesin Cikis Yapilanlar" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="ExitVehiclesGrid" Grid.Row="1" ItemsSource="{Binding ExitVehiclesView}" SelectionChanged="ExitVehiclesGrid_SelectionChanged" PreviewTextInput="ExitVehiclesGrid_PreviewTextInput" PreviewKeyDown="ExitVehiclesGrid_PreviewKeyDown" AlternatingRowBackground="#D1D5DB" RowBackground="#F8FAFC" FontSize="13" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Plaka}" Width="98">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="Plaka" />
                                            <TextBox Tag="ExitPlaka" Width="78" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Plaka filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding FirmaAdi}" Width="130">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="Firma" />
                                            <TextBox Tag="ExitFirma" Width="104" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Firma filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="D. Gelis Tarihi" Binding="{Binding GirisTarihi}" Width="88" />
                                <DataGridTextColumn Header="D. Gelis Saati" Binding="{Binding GirisSaati}" Width="76" />
                                <DataGridTextColumn Header="D. Cikis Tarihi" Binding="{Binding DoluCikisTarihi}" Width="88" />
                                <DataGridTextColumn Header="D. Cikis Saati" Binding="{Binding DoluCikisSaati}" Width="76" />
                                <DataGridTextColumn Header="Cikis Tarihi" Binding="{Binding CikisTarihi}" Width="88" />
                                <DataGridTextColumn Header="Cikis Saati" Binding="{Binding CikisSaati}" Width="76" />
                                <DataGridTextColumn Header="B. Gelis Tarihi" Binding="{Binding BosGelisTarihi}" Width="88" />
                                <DataGridTextColumn Header="B. Gelis Saati" Binding="{Binding BosGelisSaati}" Width="76" />
                                <DataGridTextColumn Header="2. Tartim Tarihi" Binding="{Binding IkinciTartimTarihi}" Width="98" />
                                <DataGridTextColumn Header="2. Tartim Saati" Binding="{Binding IkinciTartimSaati}" Width="90" />
                                <DataGridTextColumn Header="1.KG:" Binding="{Binding Tartim}" Width="78" />
                                <DataGridTextColumn Header="2.KG:" Binding="{Binding IkinciTartim}" Width="78" />
                                <DataGridTextColumn Header="Net:" Binding="{Binding NetAgirlik}" Width="78" />
                                <DataGridTextColumn Header="Ucret:" Binding="{Binding Ucret}" Width="86" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Makbuz, arastirma ve yedekleme islemleri sonraki adimda bu alana baglanacak." Foreground="{StaticResource Muted}" FontSize="12" Margin="2,4,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Background="#EEEEEE" BorderBrush="#9CA3AF" BorderThickness="1" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabControl>
                            <TabItem Header="2. Tartim Bekleyenler">
                                <DataGrid ItemsSource="{Binding PendingWeighings}" AlternatingRowBackground="#D1D5DB" RowBackground="#F8FAFC" FontSize="13" RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Plaka" Binding="{Binding Plaka}" Width="90" />
                                        <DataGridTextColumn Header="Firma" Binding="{Binding FirmaAdi}" Width="140" />
                                        <DataGridTextColumn Header="Ilk Tartim Tarihi" Binding="{Binding IlkTartimTarihi}" Width="105" />
                                        <DataGridTextColumn Header="Ilk Tartim Saati" Binding="{Binding IlkTartimSaati}" Width="96" />
                                        <DataGridTextColumn Header="1.KG" Binding="{Binding IlkAgirlik}" Width="88" />
                                        <DataGridTextColumn Header="Durum" Binding="{Binding Aciklama}" Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Son Islem">
                                <Grid>
                                    <TextBox x:Name="SelectedVehicleDetailTextBox"
                                             Text="Listeden bir arac secildiginde tartim ve ucret dokumu burada gorunecek."
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Height="Auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             FontWeight="Normal"
                                             BorderBrush="#9CA3AF"
                                             Background="#F8FAFC" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#16202C" Padding="8" Margin="0,10,0,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Menu" MinHeight="34" Padding="16,4" FontSize="13" Margin="0,0,8,0" Click="MenuButton_Click" />
                            <Button Content="Makbuz" MinHeight="34" Padding="16,4" FontSize="13" Margin="0,0,8,0" Click="KantarFisiYazdir_Click" />
                            <Button Content="Arastir" MinHeight="34" Padding="16,4" FontSize="13" Margin="0,0,8,0" Click="MenuButton_Click" />
                            <Button Content="Yedekler" MinHeight="34" Padding="16,4" FontSize="13" Click="MenuButton_Click" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Yenile" Style="{StaticResource PrimaryButton}" MinHeight="34" Padding="16,4" FontSize="13" Margin="0,0,8,0" Click="RefreshButton_Click" />
                            <Button Content="Kapat" Style="{StaticResource DangerButton}" MinHeight="34" Padding="16,4" FontSize="13" Click="MenuButton_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid x:Name="EntryPageContent" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="470" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="22" Margin="0,0,18,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Arac Giris" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Sahaya giren arac icin giris kaydi ve istege bagli ilk tartim olustur." Foreground="{StaticResource Muted}" Margin="0,4,0,18" />

                            <TextBlock Text="Plaka" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="EntryPlakaTextBox" CharacterCasing="Upper" Margin="0,0,0,14" />
                            <TextBlock Text="Firma" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="EntryFirmaTextBox" Margin="0,0,0,14" />
                            <TextBlock Text="Aciklama" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="EntryAciklamaTextBox" Height="70" FontSize="14" FontWeight="Normal" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="EntryTartimIsteniyorCheckBox" Content="Giris tartimi yapilmayacak" FontSize="15" Margin="0,0,12,0" />
                                <CheckBox x:Name="EntryManuelTartimCheckBox" Grid.Column="1" Content="Manuel tartim" FontSize="15" />
                            </Grid>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Giris Agirligi" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox x:Name="EntryAgirlikTextBox" Text="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Birim" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox Text="kg" IsReadOnly="True" />
                                </StackPanel>
                            </Grid>

                            <Button Content="Giris Kaydini Tamamla" Style="{StaticResource PrimaryButton}" MinHeight="54" Margin="0,0,0,10" Click="EntryPageGirisKaydiOlustur_Click" />
                            <Button Content="Formu Temizle" MinHeight="48" Margin="0,0,0,18" Click="EntryFormTemizle_Click" />

                            <Border Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Tahakkuk Ozeti" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="Giris-Cikis ucreti her giriste otomatik eklenir." Foreground="{StaticResource Muted}" Margin="0,8,0,2" />
                                    <TextBlock Text="Tartim seciliyse tartim ucreti de eklenir." Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Bugunku Girisler / Icerideki Araclar" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="Liste SQL veritabanindan yenilenir." Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Yenile" Width="110" Click="RefreshButton_Click" />
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding EntryVehiclesView}" SelectionChanged="EntryVehiclesGrid_SelectionChanged" PreviewTextInput="EntryVehiclesGrid_PreviewTextInput" PreviewKeyDown="EntryVehiclesGrid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Plaka}" Width="98">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
