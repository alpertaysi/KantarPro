<Window x:Class="KantarPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Gumruk Kantar Otomasyon Sistemi"
        Width="1320"
        Height="820"
        MinWidth="1180"
        MinHeight="720"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1B2430" />
        <SolidColorBrush x:Key="Muted" Color="#637083" />
        <SolidColorBrush x:Key="Line" Color="#D8E0E8" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Primary" Color="#0F766E" />
        <SolidColorBrush x:Key="PrimaryDark" Color="#115E59" />
        <SolidColorBrush x:Key="Warn" Color="#B45309" />

        <Style TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDark}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#991B1B" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuItemBorder"
                                Background="Transparent"
                                CornerRadius="5"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#E0F2FE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevenueCalendarStyle" TargetType="{x:Type Calendar}">
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.22" ScaleY="1.22" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevenueDatePickerStyle" TargetType="{x:Type DatePicker}">
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CalendarStyle" Value="{StaticResource RevenueCalendarStyle}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Gumruk Kantar Otomasyon Sistemi" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="Bursa Tasfiye Isletme Mudurlugu - Giris ve cikis kantari ortak operasyon ekrani" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,9" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ClockText" Text="19:30:00" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <Border Grid.Row="1" Background="#16202C" CornerRadius="0" Padding="4" Margin="0,0,0,6">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Giriş-Çıkış İşlemleri" Style="{StaticResource PrimaryButton}" MinHeight="28" Padding="12,4" FontSize="13" Margin="0,0,4,0" Click="AracGirisButton_Click" />
                        <Button Content="Günlük Tahsilat" MinHeight="28" Padding="12,4" FontSize="13" Margin="0,0,4,0" Click="GunlukHasilatButton_Click" />
                        <Button Content="Ayarlar" MinHeight="28" Padding="12,4" FontSize="13" Margin="0,0,4,0" Click="AyarlarButton_Click" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SqlStatusText" Text="SQL: Bagli" Foreground="#86EFAC" Margin="18,0,12,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ComStatusText" Text="COM: Beklemede" Foreground="#FCD34D" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StationStatusText" Text="Giris Kantari" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="AutoRefreshStatusText" Text="Oto: -" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="DashboardContent" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.02*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="0.86*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="470" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#ECECEC" BorderBrush="#9CA3AF" BorderThickness="1" Padding="8" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="1.Arac" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,10" />

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Plaka No:" VerticalAlignment="Center" Margin="0,0,6,8" />
                            <TextBox x:Name="PlakaTextBox" Grid.Column="1" CharacterCasing="Upper" Height="26" Padding="6,2" FontSize="13" FontWeight="Bold" Background="#C9E6C8" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Text="Giris Tarihi:" VerticalAlignment="Center" Margin="0,0,6,8" />
                            <TextBox x:Name="GirisTarihiTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding Source={x:Static sys:DateTime.Today}, Path=., Mode=OneWay, StringFormat={}{0:dd.MM.yyyy}}" Height="26" Padding="6,2" FontSize="13" FontWeight="Bold" Background="#C9E6C8" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Saat:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,8" />
                            <TextBox x:Name="GirisSaatiTextBox" Grid.Row="1" Grid.Column="3" Height="26" Padding="4,2" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="White" Background="#0284C7" BorderBrush="#0369A1" BorderThickness="1" TextAlignment="Center" Margin="0,0,0,8" TextChanged="GirisSaatiTextBox_TextChanged" />

                            <TextBlock Grid.Row="2" Text="Cikis Tarihi:" VerticalAlignment="Center" Margin="0,0,6,8" />
                            <TextBox x:Name="CikisTarihiTextBox" Grid.Row="2" Grid.Column="1" Text="{Binding Source={x:Static sys:DateTime.Today}, Path=., Mode=OneWay, StringFormat={}{0:dd.MM.yyyy}}" Height="26" Padding="6,2" FontSize="13" FontWeight="Bold" Background="#C9E6C8" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,0,8" TextChanged="CikisTarihiTextBox_TextChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Saat:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,8" />
                            <TextBox x:Name="CikisSaatiTextBox" Grid.Row="2" Grid.Column="3" Height="26" Padding="4,2" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="White" Background="#0284C7" BorderBrush="#0369A1" BorderThickness="1" TextAlignment="Center" Margin="0,0,0,8" TextChanged="CikisSaatiTextBox_TextChanged" />

                            <TextBlock Grid.Row="3" Text="Musteri Adi:" VerticalAlignment="Center" Margin="0,0,6,8" />
                            <TextBox x:Name="FirmaTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="26" Padding="6,2" FontSize="13" FontWeight="SemiBold" Background="#C9E6C8" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Text="Aciklama:" VerticalAlignment="Center" Margin="0,0,6,8" />
                            <TextBox x:Name="AciklamaTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Height="26" Padding="6,2" FontSize="13" FontWeight="SemiBold" Background="#C9E6C8" BorderBrush="#6B7280" BorderThickness="1" Margin="0,0,0,8" />

                            <Grid Grid.Row="5" Grid.ColumnSpan="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1.KG:" FontSize="26" Foreground="Black" VerticalAlignment="Center" />
                                <TextBox x:Name="AgirlikTextBox" Grid.Column="1" Text="0" Height="48" Padding="8,5" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Background="#FFFFE1" BorderBrush="#6B7280" BorderThickness="1" TextAlignment="Right" />
                                <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <Button x:Name="EntrySaveButton" Content="Kaydet" Style="{StaticResource PrimaryButton}" MinHeight="34" Padding="10,4" FontSize="13" Margin="0,0,0,6" Click="TartVeKaydet_Click" />
                                    <Button x:Name="EntryCorrectionCancelButton" Content="Vazgeç" Style="{StaticResource DangerButton}" MinHeight="34" Padding="10,4" FontSize="13" Visibility="Collapsed" Click="EntryCorrectionCancelButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#F3F4F6" BorderBrush="#9CA3AF" BorderThickness="1" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Dolu-Boş Kantar Hareketleri" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DataGrid x:Name="EntryVehiclesGrid" MinWidth="980" ItemsSource="{Binding EntryVehiclesView}" SelectionChanged="EntryVehiclesGrid_SelectionChanged" PreviewTextInput="EntryVehiclesGrid_PreviewTextInput" PreviewKeyDown="EntryVehiclesGrid_PreviewKeyDown" PreviewMouseRightButtonDown="EntryVehiclesGrid_PreviewMouseRightButtonDown" AlternatingRowBackground="#D1D5DB" RowBackground="#F8FAFC" FontSize="13" RowHeight="28" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Tart" Click="EntryGridTartMenuItem_Click" />
                                        <MenuItem Header="Kayit Duzelt" Click="EntryGridPlakaDuzeltMenuItem_Click" />
                                        <MenuItem Header="Firma Guncelle" Click="EntryGridFirmaGuncelleMenuItem_Click" />
                                        <MenuItem Header="Ücretten Muaf" Click="EntryGridMuafMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Makbuz Yazdir" Click="EntryGridMakbuzYazdirMenuItem_Click" />
                                        <MenuItem Header="Makbuz Goster" Click="EntryGridMakbuzGosterMenuItem_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="110" />
                                    <DataGridTextColumn Binding="{Binding Plaka}" Width="98">
                                        <DataGridTextColumn.Header>
                                            <StackPanel>
                                                <TextBlock Text="Plaka" />
                                                <TextBox Tag="EntryPlaka" Width="78" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Plaka filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding FirmaAdi}" Width="146">
                                        <DataGridTextColumn.Header>
                                            <StackPanel>
                                                <TextBlock Text="Firma" />
                                                <TextBox Tag="EntryFirma" Width="118" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Firma filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Son Tartim Tarihi" Binding="{Binding SonTartimTarihi}" Width="108" />
                                    <DataGridTextColumn Header="Son Tartim Saati" Binding="{Binding SonTartimSaati}" Width="104" />
                                    <DataGridTextColumn Header="Tartim" Binding="{Binding SonTartim}" Width="96" />
                                    <DataGridTextColumn Header="Giris-Cikis" Binding="{Binding GirisCikisUcreti}" Width="92" />
                                    <DataGridTextColumn Header="Tartim Ucreti" Binding="{Binding TartimUcreti}" Width="92" />
                                    <DataGridTextColumn Header="Bekleme" Binding="{Binding BeklemeUcreti}" Width="82" />
                                    <DataGridTextColumn Header="Toplam" Binding="{Binding Ucret}" Width="92" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Cikis Yap" Style="{StaticResource PrimaryButton}" MinHeight="34" Padding="14,4" FontSize="13" Margin="0,0,8,0" Click="CikisIsleminiTamamla_Click" />
                            <Button Content="Makbuz" MinHeight="34" Padding="14,4" FontSize="13" Margin="0,0,8,0" Click="KantarFisiYazdir_Click" />
                            <Button Content="Menu" MinHeight="34" Padding="14,4" FontSize="13" Click="MenuButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#EEEEEE" BorderBrush="#9CA3AF" BorderThickness="1" Padding="4">
                    <Grid>
                        <TabControl>
                            <TabItem Header="2. Tartım Bekleyenler">
                                <DataGrid x:Name="PendingWeighingsGrid" ItemsSource="{Binding PendingWeighings}" SelectionChanged="PendingWeighingsGrid_SelectionChanged" PreviewMouseRightButtonDown="PendingWeighingsGrid_PreviewMouseRightButtonDown" AlternatingRowBackground="#D1D5DB" RowBackground="#F8FAFC" FontSize="13" RowHeight="28">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Kantar Fisi Yazdir" Click="PendingGridMakbuzYazdirMenuItem_Click" />
                                            <MenuItem Header="Kantar Fisi Goster" Click="PendingGridMakbuzGosterMenuItem_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Plaka" Binding="{Binding Plaka}" Width="120" />
                                        <DataGridTextColumn Header="Firma" Binding="{Binding FirmaAdi}" Width="250" />
                                        <DataGridTextColumn Header="İlk Tartım Tarihi" Binding="{Binding IlkTartimTarihi}" Width="150" />
                                        <DataGridTextColumn Header="İlk Tartım Saati" Binding="{Binding IlkTartimSaati}" Width="120" />
                                        <DataGridTextColumn Header="1. KG" Binding="{Binding IlkAgirlik}" Width="120" />
                                        <DataGridTextColumn Header="Durum" Binding="{Binding Aciklama}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            
                            <TabItem Header="Kesin Çıkış Yapanlar">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="ExitVehiclesGrid" Grid.Row="0" ItemsSource="{Binding ExitVehiclesView}" SelectionChanged="ExitVehiclesGrid_SelectionChanged" PreviewTextInput="ExitVehiclesGrid_PreviewTextInput" PreviewKeyDown="ExitVehiclesGrid_PreviewKeyDown" PreviewMouseRightButtonDown="ExitVehiclesGrid_PreviewMouseRightButtonDown" AlternatingRowBackground="#D1D5DB" RowBackground="#F8FAFC" FontSize="13" RowHeight="28">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Kantar Fisi Yazdir" Click="ExitGridMakbuzYazdirMenuItem_Click" />
                                                <MenuItem Header="Kantar Fisi Goster" Click="ExitGridMakbuzGosterMenuItem_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding Plaka}" Width="120">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Plaka" />
                                                        <TextBox Tag="ExitPlaka" Width="100" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Plaka filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding FirmaAdi}" Width="220">
                                                <DataGridTextColumn.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="Firma" />
                                                        <TextBox Tag="ExitFirma" Width="180" Height="22" Padding="4,1" FontSize="12" FontWeight="Normal" ToolTip="Firma filtrele" TextChanged="ColumnFilterTextBox_TextChanged" />
                                                    </StackPanel>
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="D. Geliş Tarihi" Binding="{Binding GirisTarihi}" Width="110" />
                                            <DataGridTextColumn Header="D. Geliş Saati" Binding="{Binding GirisSaati}" Width="95" />
                                            <DataGridTextColumn Header="D. Çıkış Tarihi" Binding="{Binding DoluCikisTarihi}" Width="110" />
                                            <DataGridTextColumn Header="D. Çıkış Saati" Binding="{Binding DoluCikisSaati}" Width="95" />
                                            <DataGridTextColumn Header="B. Geliş Tarihi" Binding="{Binding BosGelisTarihi}" Width="110" />
                                            <DataGridTextColumn Header="B. Geliş Saati" Binding="{Binding BosGelisSaati}" Width="95" />
                                            <DataGridTextColumn Header="1. KG" Binding="{Binding Tartim}" Width="90" />
                                            <DataGridTextColumn Header="2. KG" Binding="{Binding IkinciTartim}" Width="90" />
                                            <DataGridTextColumn Header="Net" Binding="{Binding NetAgirlik}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="1" Text="Makbuz, araştırma ve yedekleme işlemleri sonraki adımda bu alana bağlanacak." Foreground="{StaticResource Muted}" FontSize="12" Margin="2,6,0,0" />
                                </Grid>
                            </TabItem>
                            
                            <TabItem Header="Son İşlem">
                                <Grid>
                                    <TextBox x:Name="SelectedVehicleDetailTextBox"
                                             Text="Listeden bir araç seçildiğinde tartım ve ücret dökümü burada görünecek."
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Height="Auto"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             FontWeight="Normal"
                                             BorderBrush="#9CA3AF"
                                             Background="#F8FAFC" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#16202C" Padding="8" Margin="0,10,0,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Menu" MinHeight="34" Padding="16,4" FontSize="13" Margin="0,0,8,0" Click="MenuButton_Click" />
                            <Button Content="Makbuz" MinHeight="34" Padding="16,4" FontSize="13" Margin="0,0,8,0" Click="KantarFisiYazdir_Click" />
                            <Button Content="Arastir" MinHeight="34" Padding="16,4" FontSize="13" Margin="0,0,8,0" Click="MenuButton_Click" />
                            <Button Content="Yedekler" MinHeight="34" Padding="16,4" FontSize="13" Click="MenuButton_Click" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Yenile" Style="{StaticResource PrimaryButton}" MinHeight="34" Padding="16,4" FontSize="13" Margin="0,0,8,0" Click="RefreshButton_Click" />
                            <Button Content="Kapat" Style="{StaticResource DangerButton}" MinHeight="34" Padding="16,4" FontSize="13" Click="MenuButton_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid x:Name="DailyRevenueContent" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="#D7DEEE" BorderBrush="#9AA9C0" BorderThickness="1" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Baslangic Tarihi" FontSize="12" Margin="0,0,0,4" />
                            <DatePicker x:Name="RevenueStartDatePicker" Style="{StaticResource RevenueDatePickerStyle}" SelectedDate="{Binding Source={x:Static sys:DateTime.Today}, Path=., Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Bitis Tarihi" FontSize="12" Margin="0,0,0,4" />
                            <DatePicker x:Name="RevenueEndDatePicker" Style="{StaticResource RevenueDatePickerStyle}" SelectedDate="{Binding Source={x:Static sys:DateTime.Today}, Path=., Mode=OneWay}" />
                        </StackPanel>
                        <Button Content="Listele" Width="120" MinHeight="40" Margin="0,16,8,0" Click="RevenueListButton_Click" />
