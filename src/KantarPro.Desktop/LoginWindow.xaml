<Window x:Class="KantarPro.Desktop.LoginWindow"
        Icon="Assets/kantarpro.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kantar Otomasyonu"
        Width="980"
        Height="660"
        MinWidth="980"
        MinHeight="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#EAF2F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0B5E58" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <Style x:Key="LoginInputStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LoginComboStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="LoginPasswordStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryLoginButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryLoginButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Border Background="#FFFFFF"
                BorderBrush="#D6E1EA"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ClipToBounds="True">
                    <Image Source="Assets/login-hero.png"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                    <Border Background="#66FFFFFF"
                            VerticalAlignment="Bottom"
                            Height="96">
                        <StackPanel VerticalAlignment="Center" Margin="34,0">
                            <TextBlock Text="Kantar Otomasyonu"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#143A5A" />
                            <TextBlock Text="Tartım, tahsilat ve saha hareketleri tek ekranda."
                                       FontSize="13"
                                       Foreground="#315B76"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1"
                        Background="#F8FBFD"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1,0,0,0"
                        Padding="42,34">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Image Source="Assets/ticaret-bakanligi-logo.png"
                                   Width="190"
                                   Height="64"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left" />

                            <TextBlock Text="Giriş Paneli"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,24,0,0" />
                            <TextBlock Text="Kullanıcıyı seçip şifrenizi girin."
                                       FontSize="14"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Top"
                                    Margin="0,34,0,0">
                            <TextBlock Text="Kullanıcı"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,6" />
                            <ComboBox x:Name="UserComboBox"
                                      Style="{StaticResource LoginComboStyle}"
                                      DisplayMemberPath="DisplayName" />

                            <TextBlock Text="Şifre"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,18,0,6" />
                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource LoginPasswordStyle}"
                                         KeyDown="PasswordBox_KeyDown" />

                            <Border x:Name="InfoBorder"
                                    Background="#FEF2F2"
                                    BorderBrush="#FCA5A5"
                                    BorderThickness="1"
                                    MinHeight="46"
                                    Margin="0,14,0,0"
                                    Padding="12"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="InfoTextBlock"
                                           Foreground="#991B1B"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="İptal"
                                    Style="{StaticResource SecondaryLoginButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="Cancel_Click" />
                            <Button Grid.Column="1"
                                    Content="Giriş"
                                    Style="{StaticResource PrimaryLoginButtonStyle}"
                                    Click="Login_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>




