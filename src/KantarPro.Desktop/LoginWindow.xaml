<Window x:Class="KantarPro.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kantar Pro Giris"
        Width="430"
        Height="330"
        MinWidth="430"
        MinHeight="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="18" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Kantar Pro"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />
            <TextBlock Grid.Row="1"
                       Text="Programa devam etmek icin kullanici adi ve sifrenizi girin."
                       Foreground="#64748B"
                       Margin="0,6,0,18"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="2">
                <TextBlock Text="Kullanici Adi" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameTextBox"
                         Height="38"
                         FontSize="16"
                         Padding="8,4" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="Sifre" FontWeight="SemiBold" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             FontSize="16"
                             Padding="8,4"
                             KeyDown="PasswordBox_KeyDown" />
            </StackPanel>

            <TextBlock x:Name="InfoTextBlock"
                       Grid.Row="4"
                       Foreground="#B91C1C"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Vazgec"
                        Width="96"
                        MinHeight="36"
                        Margin="0,0,8,0"
                        Click="Cancel_Click" />
                <Button Content="Giris Yap"
                        Width="112"
                        MinHeight="36"
                        Foreground="White"
                        Background="#0F766E"
                        BorderBrush="#115E59"
                        Click="Login_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
