<Window x:Class="KantarPro.Desktop.DateInputWindow"
        Icon="Assets/kantarpro.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Geliş Tarihi"
        Width="400"
        Height="205"
        MinWidth="400"
        MinHeight="205"
        MaxWidth="520"
        MaxHeight="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Geliş tarihini gir" FontSize="19" FontWeight="SemiBold" Foreground="#1B2430" />
        <TextBlock Grid.Row="1" Text="Örnek: 12.05.2026 11:00:00" Foreground="#637083" Margin="0,4,0,12" />
        <TextBox x:Name="DateTextBox"
                 Grid.Row="2"
                 Height="34"
                 Padding="8,4"
                 FontSize="15"
                 FontFamily="Consolas"
                 VerticalContentAlignment="Center" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Kaydet" Width="96" MinHeight="34" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Vazgeç" Width="96" MinHeight="34" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>




