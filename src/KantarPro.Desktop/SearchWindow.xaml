<Window x:Class="KantarPro.Desktop.SearchWindow"
        Icon="Assets/kantarpro.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Araştır"
        Width="1280"
        Height="720"
        MinWidth="1000"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1B2430" />
        <SolidColorBrush x:Key="Muted" Color="#637083" />
        <SolidColorBrush x:Key="Line" Color="#D8E0E8" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Primary" Color="#0F766E" />
        <SolidColorBrush x:Key="PrimaryDark" Color="#115E59" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDark}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="18,0,0,0"
                                VerticalAlignment="Bottom">
                        <Button Content="Ara"
                                Style="{StaticResource PrimaryButton}"
                                Width="92"
                                Margin="0,0,8,0"
                                Click="Search_Click" />
                        <Button Content="OKI Önizle"
                                Width="120"
                                Margin="0,0,8,0"
                                Click="Preview_Click" />
                        <Button Content="Kapat"
                                Width="92"
                                Click="Close_Click" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Plaka" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox x:Name="PlateTextBox" CharacterCasing="Upper" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Firma" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox x:Name="CompanyTextBox" />
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Giriş Tarihi"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"
                                   Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Başlangıç"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="12"
                                           Margin="0,0,0,3" />
                                <DatePicker x:Name="EntryStartDatePicker" Width="160" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Bitiş"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="12"
                                           Margin="0,0,0,3" />
                                <DatePicker x:Name="EntryEndDatePicker" Width="160" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Çıkış Tarihi"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"
                                   Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Başlangıç"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="12"
                                           Margin="0,0,0,3" />
                                <DatePicker x:Name="ExitStartDatePicker" Width="160" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Bitiş"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="12"
                                           Margin="0,0,0,3" />
                                <DatePicker x:Name="ExitEndDatePicker" Width="160" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="2"
                           Text="Son 500 geçmiş kayıt için plaka, firma, giriş ve çıkış tarih aralığı ile arama yapın."
                           Foreground="{StaticResource Muted}"
                           Margin="0,10,0,0" />
            </Grid>
        </Border>

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Results}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AlternatingRowBackground="#D1D5DB"
                  RowBackground="#F8FAFC"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="27"
                  FontSize="13"
                  BorderBrush="{StaticResource Line}"
                  BorderThickness="1"
                  HorizontalScrollBarVisibility="Visible"
                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="PreviewMouseRightButtonDown"
                                 Handler="ResultsGridRow_PreviewMouseRightButtonDown" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Kantar Fişi Göster"
                              Click="SearchReceiptPreview_Click" />
                    <MenuItem Header="Kantar Fişi Yazdır"
                              Click="SearchReceiptPrint_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sıra" Binding="{Binding SiraNo}" Width="48" />
                <DataGridTextColumn Header="İşlem No" Binding="{Binding IslemNo}" Width="82" />
                <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="135" />
                <DataGridTextColumn Header="Plaka" Binding="{Binding Plaka}" Width="105" />
                <DataGridTextColumn Header="Firma" Binding="{Binding Firma}" Width="170" />
                <DataGridTextColumn Header="Giriş Tarihi" Binding="{Binding GirisTarihi}" Width="95" />
                <DataGridTextColumn Header="Giriş Saati" Binding="{Binding GirisSaati}" Width="85" />
                <DataGridTextColumn Header="Çıkış Tarihi" Binding="{Binding CikisTarihi}" Width="95" />
                <DataGridTextColumn Header="Çıkış Saati" Binding="{Binding CikisSaati}" Width="85" />
                <DataGridTextColumn Header="1. Tartım" Binding="{Binding BirinciTartim}" Width="95" />
                <DataGridTextColumn Header="2. Tartım" Binding="{Binding IkinciTartim}" Width="95" />
                <DataGridTextColumn Header="Net" Binding="{Binding Net}" Width="85" />
                <DataGridTextColumn Header="Tahsilat No" Binding="{Binding TahsilatNo}" Width="105" />
                <DataGridTextColumn Header="Ödeme Türü" Binding="{Binding OdemeTuru}" Width="110" />
                <DataGridTextColumn Header="Fiş No" Binding="{Binding KantarFisNo}" Width="82" />
                <DataGridTextColumn Header="Kullanıcı" Binding="{Binding Kullanici}" Width="140" />
                <DataGridTextColumn Header="Toplam Ücret" Binding="{Binding ToplamUcret}" Width="105" />
                <DataGridTextColumn Header="Notlar" Binding="{Binding Notlar}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="Tarih alanları boş bırakılırsa ilgili aralık filtresi uygulanmaz."
                   Foreground="{StaticResource Muted}"
                   FontSize="12"
                   Margin="2,8,0,0" />
    </Grid>
</Window>
