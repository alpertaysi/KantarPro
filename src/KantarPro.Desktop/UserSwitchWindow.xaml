<Window x:Class="KantarPro.Desktop.UserSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kullanıcı Değiştir"
        Icon="Assets/kantarpro.ico"
        Width="470"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Kullanıcı Değiştir"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#0F172A" />
        <TextBlock Grid.Row="1"
                   Text="Kullanıcıyı seçip şifresini girerek oturumu değiştirebilirsiniz."
                   Margin="0,5,0,14"
                   Foreground="#64748B"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Kullanıcı" FontWeight="SemiBold" Margin="0,0,0,5" />
            <ComboBox x:Name="UserComboBox"
                      Height="36"
                      DisplayMemberPath="DisplayName" />
            <TextBlock Text="Şifre" FontWeight="SemiBold" Margin="0,12,0,5" />
            <PasswordBox x:Name="PasswordBox"
                         Height="36"
                         Padding="8,4"
                         KeyDown="PasswordBox_KeyDown" />
        </StackPanel>

        <Border x:Name="InfoBorder"
                Grid.Row="3"
                Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                Padding="10"
                Margin="0,12,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="InfoTextBlock"
                       Foreground="#991B1B"
                       TextWrapping="Wrap" />
        </Border>

        <GroupBox Grid.Row="4"
                  Header="Şifre Değiştir"
                  Margin="0,16,0,0"
                  Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mevcut Şifre" VerticalAlignment="Center" />
                <PasswordBox x:Name="CurrentPasswordBox"
                             Grid.Column="1"
                             Height="32"
                             Padding="7,3" />
                <TextBlock Grid.Row="1"
                           Text="Yeni Şifre"
                           VerticalAlignment="Center"
                           Margin="0,8,0,0" />
                <PasswordBox x:Name="NewPasswordBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Height="32"
                             Padding="7,3"
                             Margin="0,8,0,0" />
                <TextBlock Grid.Row="2"
                           Text="Yeni Şifre Tekrar"
                           VerticalAlignment="Center"
                           Margin="0,8,0,0" />
                <PasswordBox x:Name="RepeatPasswordBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Height="32"
                             Padding="7,3"
                             Margin="0,8,0,0" />
                <Button Grid.Row="3"
                        Grid.Column="1"
                        Content="Şifreyi Değiştir"
                        Width="140"
                        Height="34"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Click="ChangePassword_Click" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Vazgeç"
                    Width="100"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="Giriş"
                    Width="110"
                    Height="36"
                    Background="#0F766E"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="Login_Click" />
        </StackPanel>
    </Grid>
</Window>
