<Window x:Class="KantarPro.Desktop.PendingWeighingChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bekleyen Ilk Tartim"
        Width="760"
        Height="460"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1B2430" />
        <SolidColorBrush x:Key="Muted" Color="#637083" />
        <SolidColorBrush x:Key="Line" Color="#D8E0E8" />
        <SolidColorBrush x:Key="Primary" Color="#0F766E" />

        <Style TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Primary}" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="RowHeight" Value="25" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Text="Bu plakaya ait tamamlanmamis ilk tartim bulundu." FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
            <TextBlock Text="Eski tartim farkli firma/ise ait olabilir. Dogru satiri secip devam et veya yeni ilk tartim ac." Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <DataGrid x:Name="PendingGrid" Grid.Row="1" ItemsSource="{Binding PendingRows}" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Plaka" Binding="{Binding Plaka}" Width="95" />
                <DataGridTextColumn Header="Firma" Binding="{Binding FirmaAdi}" Width="160" />
                <DataGridTextColumn Header="Ilk Tarih" Binding="{Binding IlkTartimTarihi}" Width="95" />
                <DataGridTextColumn Header="Saat" Binding="{Binding IlkTartimSaati}" Width="80" />
                <DataGridTextColumn Header="1.KG" Binding="{Binding IlkAgirlik}" Width="90" />
                <DataGridTextColumn Header="Aciklama" Binding="{Binding Aciklama}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>

            <Button Content="Eski Tartimi Kullan" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="UseExisting_Click" />
            <Button Grid.Column="1" Content="Yeni Ilk Tartim Ac" Margin="8,0,8,0" Click="CreateNew_Click" />
            <Button Grid.Column="2" Content="Vazgec" Margin="8,0,0,0" Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>
