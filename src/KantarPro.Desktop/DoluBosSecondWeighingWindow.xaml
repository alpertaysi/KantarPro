<Window x:Class="KantarPro.Desktop.DoluBosSecondWeighingWindow"
        Icon="Assets/kantarpro.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Çıkış İşlemi"
        Width="720"
        Height="650"
        MinWidth="720"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F1F1F1"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="BorderBrush" Value="#8A8A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="BorderBrush" Value="#8A8A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="306" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#9A9A9A" BorderThickness="1" Background="#F1F1F1">
            <Grid Margin="42,32,34,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="118" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Plaka No:" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,4,0" />
                    <TextBox x:Name="PlateTextBox" Grid.Column="1" FontSize="22" FontWeight="Bold" Foreground="#0059C8" Height="30" Text="01AFE890" IsReadOnly="True" />

                    <TextBlock Grid.Row="1" Text="Giriş Tarihi:" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,4,0" />
                    <TextBox x:Name="EntryDateTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Saat:" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,4,0" />
                    <TextBox x:Name="EntryTimeTextBox" Grid.Row="1" Grid.Column="3" IsReadOnly="True" TextAlignment="Right" />

                    <TextBlock Grid.Row="2" Text="Çıkış Tarihi:" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,4,0" />
                    <TextBox x:Name="ExitDateTextBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Saat:" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,4,0" />
                    <TextBox x:Name="ExitTimeTextBox" Grid.Row="2" Grid.Column="3" IsReadOnly="True" TextAlignment="Right" />

                    <TextBlock Grid.Row="3" Text="Müşteri Adı:" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,4,0" />
                    <TextBox x:Name="CustomerTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" />

                    <TextBlock Grid.Row="4" Text="Açıklama:" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,4,0" />
                    <TextBox x:Name="DescriptionTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#9A9A9A" BorderThickness="1,0,1,1" Background="#F1F1F1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,20">
                    <Grid Width="250">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="126" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="1.KG:" FontSize="20" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,5,0" />
                        <TextBox x:Name="FirstWeightTextBox" Grid.Column="1" Text="0" IsReadOnly="True" Height="30" FontSize="20" FontWeight="Bold" TextAlignment="Right" />

                        <TextBlock Grid.Row="1" Text="2.KG" FontSize="20" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,5,0" />
                        <TextBox x:Name="SecondWeightTextBox" Grid.Row="1" Grid.Column="1" Text="0" IsReadOnly="True" IsTabStop="False" Height="30" FontSize="20" FontWeight="Bold" TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Text="Net" FontSize="20" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,5,0" />
                        <TextBox x:Name="NetWeightTextBox" Grid.Row="2" Grid.Column="1" Text="0" IsReadOnly="True" Height="36" FontSize="24" FontWeight="Bold" TextAlignment="Right" Background="#EFC49B" />
                    </Grid>
                    <Button Content="Kilo Al" Width="100" Height="58" Margin="8,38,0,0" Background="#111827" Foreground="White" FontSize="20" FontWeight="Bold" Click="TakeWeight_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                <Button Content="Kaydet" Width="96" Background="#05A000" Foreground="White" Margin="0,0,14,0" Click="Save_Click" />
                <Button Content="Vazgeç" Width="96" Background="#111111" Foreground="White" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>




