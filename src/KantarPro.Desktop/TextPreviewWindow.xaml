<Window x:Class="KantarPro.Desktop.TextPreviewWindow"
        Icon="Assets/kantarpro.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metin Önizleme"
        Width="920"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="18,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="TitleTextBlock"
                           Text="Metin Önizleme"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#0F172A" />
                <TextBlock Text="OKI uyumlu ham metin dökümü"
                           Foreground="#64748B"
                           FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="PreviewTextBox"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="White"
                         FontFamily="Courier New"
                         FontSize="13"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         AcceptsTab="True" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <TextBlock Text="Font"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"
                       Foreground="#475569" />
            <TextBox x:Name="DriverFontSizeTextBox"
                     Text="9"
                     Width="44"
                     Height="32"
                     VerticalContentAlignment="Center"
                     TextAlignment="Center"
                     Margin="0,0,12,0" />
            <Button Content="Yazdır" Click="Print_Click" />
            <Button Content="Kapat" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
