<Window x:Class="KantarPro.Desktop.AlreadyRunningWindow"
        Icon="Assets/kantarpro.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KantarPro"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Border Background="#FFFFFF"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="4"
                              Direction="270"
                              Opacity="0.22" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Üst çubuk - Uyarı için turuncu/sarı ton -->
            <Border Background="#D97706" CornerRadius="8,8,0,0" />

            <StackPanel Grid.Row="1" Margin="26,24,26,22">
                <!-- İkon ve başlık -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Uyarı ikonu -->
                    <Viewbox Width="32" Height="32" VerticalAlignment="Top">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#D97706" Data="M12 2L1 21h22L12 2zm0 3.83L20.18 19H3.82L12 5.83zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Program Zaten Çalışıyor"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="KantarPro uygulaması şu anda zaten açık."
                                   FontSize="14"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Açıklama metni -->
                <Border Background="#FEF3C7"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Lütfen açık olan programı kullanın."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#78350F"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Aynı anda sadece bir KantarPro programı çalışabilir. Bu özellik veri çakışmalarını ve hatalı işlemleri önler."
                                   FontSize="13"
                                   Foreground="#92400E"
                                   TextWrapping="Wrap"
                                   LineHeight="18" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Alt buton alanı -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="16,14">
                <Button Content="Tamam"
                        Width="120"
                        Height="38"
                        HorizontalAlignment="Right"
                        Background="#0F766E"
                        BorderBrush="#115E59"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        Click="OkButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ReadableButtonBase}">
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
