<Window x:Class="KantarPro.Desktop.ExitConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arac Cikis Islemleri"
        Width="420"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#D7DEEE"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="BorderBrush" Value="#9AA9C0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#E6ECF7" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#DDE5F3" />
            <Setter Property="BorderBrush" Value="#8798B4" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Border BorderBrush="#9AA9C0" BorderThickness="1" Padding="14" Background="#D7DEEE">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PlateText"
                           Text="PLAKA"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#0B274C"
                           Margin="0,0,0,8" />

                <GroupBox Grid.Row="1" Header="Giris - Cikis Tarih/Saat" BorderBrush="#9AA9C0" Margin="0,0,0,12">
                    <Grid Margin="10,8,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Giris Bilgileri" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" />
                        <TextBox x:Name="EntryDateText" Grid.Column="2" />
                        <TextBox x:Name="EntryTimeText" Grid.Column="4" />

                        <TextBlock Grid.Row="2" Text="Cikis Bilgileri" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text=":" VerticalAlignment="Center" />
                        <TextBox x:Name="ExitDateText" Grid.Row="2" Grid.Column="2" />
                        <TextBox x:Name="ExitTimeText" Grid.Row="2" Grid.Column="4" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Ucret Bilgileri" BorderBrush="#9AA9C0" Margin="0,0,0,8">
                    <Grid Margin="10,8,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Giris / Cikis Ucreti" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" />
                        <TextBox x:Name="EntryExitFeeText" Grid.Column="2" />
                        <TextBlock Grid.Column="3" Text="TL" VerticalAlignment="Center" Margin="6,0,0,0" />

                        <TextBlock Grid.Row="2" x:Name="WeighingFeeLabel" Text="Toplam Tart Ucreti" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text=":" VerticalAlignment="Center" />
                        <TextBox x:Name="WeighingFeeText" Grid.Row="2" Grid.Column="2" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="TL" VerticalAlignment="Center" Margin="6,0,0,0" />

                        <TextBlock Grid.Row="4" x:Name="WaitingFeeLabel" Text="Isgaliye Ucreti" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text=":" VerticalAlignment="Center" />
                        <TextBox x:Name="WaitingFeeText" Grid.Row="4" Grid.Column="2" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="TL" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </GroupBox>

                <Border Grid.Row="3" BorderBrush="#9AA9C0" BorderThickness="1" Padding="10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Toplam Ucret" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text=":" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBox x:Name="TotalFeeText" Grid.Column="2" FontSize="18" FontWeight="Bold" Foreground="#B00000" />
                        <TextBlock Grid.Column="3" Text="TL" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </Border>

                <TextBlock x:Name="InfoText"
                           Grid.Row="4"
                           Foreground="#394B63"
                           TextWrapping="Wrap"
                           Margin="2,0,2,8" />

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="Arac Cikis Yap" Click="ConfirmExit_Click" />
                    <Button Grid.Column="3" Content="Iptal" Click="Cancel_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
