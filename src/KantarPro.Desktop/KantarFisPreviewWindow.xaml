<Window x:Class="KantarPro.Desktop.KantarFisPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kantar Fişi Önizleme"
        Width="760"
        Height="620"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="OKI 5720 Kantar Fişi Önizleme"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1" Background="White" BorderBrush="#9CA3AF" BorderThickness="1" Padding="18">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="ReceiptTextBox"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="White"
                         FontFamily="Courier New"
                         FontSize="14"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         AcceptsTab="True" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Yazdır"
                    Width="110"
                    MinHeight="34"
                    Margin="0,0,8,0"
                    Click="Print_Click" />
            <Button Content="Kapat"
                    Width="110"
                    MinHeight="34"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
