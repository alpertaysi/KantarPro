<Window x:Class="KantarPro.Desktop.KantarFisPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kantar Fisi Onizleme"
        Width="860"
        Height="680"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorder" Color="#CBD5E1" />
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedText" Color="#64748B" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Kantar Fisi Onizleme"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#0F172A" />
                <TextBlock x:Name="ContinuousFormNoteTextBlock"
                           Foreground="{StaticResource MutedText}"
                           FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="#0F766E"
                    CornerRadius="4"
                    Padding="12,6"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ReceiptTypeTextBlock"
                           Foreground="White"
                           FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <TabControl x:Name="PreviewTabs" Grid.Row="1">
            <TabItem Header="Onizleme">
                <Border Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        Padding="22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="TICARET BAKANLIGI"
                                       TextAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#111827" />
                            <TextBlock Text="ULUDAG GUMRUK VE TICARET BOLGE MUDURLUGU"
                                       TextAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="BURSATASFIYE ISLETME MUDURLUGU"
                                       TextAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,4,0,22" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="PLAKA" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock x:Name="PlateTextBlock" Style="{StaticResource FieldValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="FIS NO" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock x:Name="ReceiptNoTextBlock" Style="{StaticResource FieldValueStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="FirstDateLabelTextBlock" Text="GIRIS TARIHI / SAATI" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock x:Name="FirstDateTextBlock" Style="{StaticResource FieldValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SecondVisitBorder" Grid.Row="1" Grid.Column="2" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="2. GIRIS TARIHI / SAATI" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock x:Name="SecondDateTextBlock" Style="{StaticResource FieldValueStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="1. TARTI" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock x:Name="FirstWeightTextBlock" Style="{StaticResource FieldValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SecondWeightBorder" Grid.Row="2" Grid.Column="2" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="2. TARTI / NET" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock x:Name="SecondWeightTextBlock" Style="{StaticResource FieldValueStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#F8FAFC"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1"
                                    Padding="14"
                                    Margin="0,22,0,0">
                                <TextBlock Text="MEMUR IMZA: ____________________"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Ham Metin">
                <Border Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        Padding="18">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="ReceiptTextBox"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="White"
                                 FontFamily="Courier New"
                                 FontSize="14"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 AcceptsTab="True" />
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Ham Metni Goster"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="ShowRawText_Click" />
            <Button Content="Yazdir"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="Print_Click" />
            <Button Content="Kapat"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
