<Window x:Class="KantarPro.Desktop.KantarFisPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kantar Fisi"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F5"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="18,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Kantar Fisi"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#0F172A" />
                <TextBlock x:Name="ContinuousFormNoteTextBlock"
                           Foreground="#64748B"
                           FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="#0F766E"
                    CornerRadius="4"
                    Padding="12,6"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ReceiptTypeTextBlock"
                           Foreground="White"
                           FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Padding="14">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="ReceiptTextBox"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="White"
                         FontFamily="Courier New"
                         FontSize="15"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         AcceptsTab="True" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <TextBlock Text="Font"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"
                       Foreground="#475569" />
            <TextBox x:Name="DriverFontSizeTextBox"
                     Text="12"
                     Width="44"
                     Height="32"
                     ToolTip="Yazdirma font boyutu."
                     VerticalContentAlignment="Center"
                     TextAlignment="Center"
                     Margin="0,0,12,0" />
            <Button Content="Yazdir"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="Print_Click" />
            <Button Content="Kapat"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
