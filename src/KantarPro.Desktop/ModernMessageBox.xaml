<Window x:Class="KantarPro.Desktop.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kantar Pro"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Border Background="#FFFFFF"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="4"
                              Direction="270"
                              Opacity="0.22" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="AccentBar"
                    Height="6"
                    CornerRadius="8,8,0,0"
                    Background="#0F766E" />

            <Grid Grid.Row="1" Margin="18,18,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconCircle"
                        Width="42"
                        Height="42"
                        CornerRadius="21"
                        Background="#E0F2FE"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText"
                               Text="i"
                               Foreground="#0369A1"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText"
                               Text="Kantar Pro"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="MessageText"
                               TextWrapping="Wrap"
                               FontSize="14"
                               LineHeight="20"
                               Foreground="#334155" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="14">
                <Button Content="Tamam"
                        Width="104"
                        Height="34"
                        HorizontalAlignment="Right"
                        Background="#0F766E"
                        BorderBrush="#115E59"
                        Foreground="White"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OkButton_Click" />
            </Border>
        </Grid>
    </Border>
</Window>
