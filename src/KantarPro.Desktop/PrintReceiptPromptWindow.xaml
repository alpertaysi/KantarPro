<Window x:Class="KantarPro.Desktop.PrintReceiptPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kantar Fisi"
        Width="390"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Border Background="#FFFFFF"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="4"
                              Direction="270"
                              Opacity="0.22" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="#0F766E" CornerRadius="8,8,0,0" />

            <StackPanel Grid.Row="1" Margin="22,20,22,18">
                <TextBlock Text="Kantar fisi yazdirilsin mi?"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="#475569" />
            </StackPanel>

            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Evet"
                            Width="104"
                            Height="36"
                            Margin="0,0,8,0"
                            Background="#0F766E"
                            BorderBrush="#115E59"
                            Foreground="White"
                            FontWeight="SemiBold"
                            IsDefault="True"
                            Click="YesButton_Click" />
                    <Button Content="Vazgeç"
                            Width="104"
                            Height="36"
                            Background="#E2E8F0"
                            BorderBrush="#CBD5E1"
                            IsCancel="True"
                            Click="CancelButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
